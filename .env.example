# Copie para .env (local) ou preencha no painel do Render. Valores fictícios.

# Banco Neon (PostgreSQL). Use a URL do branch de produção (ou dev, localmente).
DATABASE_URL=postgresql://usuario_exemplo:senha_exemplo@ep-exemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Assinatura do token JWT. Gere um valor longo e aleatório, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_DAYS=7

# Usuária criada no startup se ainda não existir nenhum usuário.
ADMIN_EMAIL=usuaria@exemplo.com.br
ADMIN_PASSWORD=troque-esta-senha-inicial
ADMIN_NOME="Usuária Exemplo"

# Alertas por e-mail (desligado por padrão: só registra no log).
EMAIL_ENABLED=false
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USER=alertas@exemplo.com.br
SMTP_PASSWORD=senha-smtp-exemplo
SMTP_FROM=EstoqueCerto <alertas@exemplo.com.br>
ALERT_EMAIL_TO=usuaria@exemplo.com.br

# URL pública do sistema (usada no link dos e-mails).
APP_URL=https://estoquecerto.exemplo.onrender.com

# Pasta do build do React servido pelo FastAPI (no Docker: /app/static).
STATIC_DIR=static
